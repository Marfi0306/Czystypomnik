{
  "name": "czysty-pomnik",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/start.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.server.config.ts && node scripts/build-meta.mjs",
    "start": "node --import tsx server/start.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:release": "node scripts/check-release.mjs",
    "verify:runtime": "node --test tests/runtime.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "express": "^5.0.0",
    "cookie-parser": "^1.4.7",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.56.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
