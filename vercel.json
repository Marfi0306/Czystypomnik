{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' blob: data: https://*.supabase.co https://www.facebook.com; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; connect-src 'self' https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/internal/retention",
      "schedule": "0 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/internal(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "czystypomnik.vercel.app"
        }
      ],
      "destination": "https://czystypomnik.waw.pl/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/internal(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "czystypomnik-marfi1.vercel.app"
        }
      ],
      "destination": "https://czystypomnik.waw.pl/:path",
      "permanent": true
    }
  ]
}
